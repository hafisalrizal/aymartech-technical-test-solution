# Environment (local | staging | production)
NODE_ENV="local"

# Database
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="designpilot_db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/designpilot_db"

# Auth
JWT_SECRET="your-super-secret-jwt-key"

# AI Provider (choose one: gemini, openrouter, ollama)
AI_PROVIDER="gemini"
AI_API_KEY="your-api-key-here"
# AI_MODEL="gemini-1.5-flash" # Optional: override default model
# AI_TIMEOUT="30000" # Optional: timeout in ms (default: 30000)
